rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Tickets collection ─────────────────────────────────────────────────
    // ALL reads and writes from browsers are denied.
    // Only the Firebase Admin SDK (server-side Route Handlers) can read/write.
    //
    // This means:
    // • A user cannot read ticket status directly from Firestore.
    // • A user cannot change a USED ticket back to VALID.
    // • Validation MUST go through POST /api/tickets/validate.
    // ───────────────────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
