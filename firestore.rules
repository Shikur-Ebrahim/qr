rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic test-mode rules that expire soon, allowing the Next.js API 
    // to freely read/write using the simplified public SDK setup.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }
  }
}
